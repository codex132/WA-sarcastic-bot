# ── Required ──────────────────────────────────────────────────────────────────
# Your WhatsApp number — international format, digits only, NO + or spaces
# Example: Nigerian number 08012345678 becomes 2348012345678
PHONE_NUMBER=2348012345678

# Get free at https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_key_here

# ── Optional (Gemini fallback if Groq rate-limits) ────────────────────────────
# Get free at https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_key_here

# ── Bot behaviour ─────────────────────────────────────────────────────────────
# Reply to group chats too? true or false
REPLY_GROUPS=false

# Minimum ms between replies to the same person (anti-spam)
COOLDOWN_MS=4000
